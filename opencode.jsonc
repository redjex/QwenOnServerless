{
  // Конфиг opencode (формат JSONC — поддерживает комментарии).
  // Провайдер Token Harbor: https://tokenharbor.ai/docs/integrations/opencode
  // Ключ вставлять не сюда, а в окружение: export TOKENHARBOR_API_KEY=thk_...
  // Ключ берётся в https://tokenharbor.ai/dashboard/api-keys
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "tokenharbor": {
      "name": "Token Harbor",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://tokenharbor.ai/v1",
        "apiKey": "{env:TOKENHARBOR_API_KEY}"
      },
      "models": {
        // Чтобы добавить модели: GET https://tokenharbor.ai/v1/models (Bearer-ключ)
        // и укажите свой context_length для каждой.
        "deepseek-v4.1-flash:free": {
          "name": "DeepSeek V4.1 Flash (Free)",
          "limit": { "context": 1048576, "output": 32000 }
        }
      }
    }
  }
}
